pragma language_version 0.23;
import CompactStandardLibrary;

export ledger authorizedCommitments: HistoricMerkleTree<10, Bytes<32>>;
export ledger spentNullifiers: Set<Bytes<32>>;
export ledger voteCommitments: MerkleTree<10, Bytes<32>>;

witness findAuthPath(pk: Bytes<32>): MerkleTreePath<10, Bytes<32>>;
witness secretKey(): Bytes<32>;

// The round is part of the nullifier domain so one citizen can participate
// once per round without making participation linkable across rounds.
circuit nullifier(round: Uint<64>, sk: Bytes<32>): Bytes<32> {
  const roundBytes = round as Field as Bytes<32>;
  return persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "cryptoguardians:nullifier"), roundBytes, sk
  ]);
}

export circuit castVote(
  pk: Bytes<32>,
  round: Uint<64>,
  vote: Bytes<32>,
  randomness: Bytes<32>
): [] {
  const authPath = findAuthPath(pk);
  assert(authPath.leaf == pk);
  assert(authorizedCommitments.checkRoot(disclose(merkleTreePathRoot<10, Bytes<32>>(authPath))));

  const nul = nullifier(round, secretKey());
  assert(!spentNullifiers.member(disclose(nul)), "Already voted this round");

  const commitment = persistentCommit(vote, randomness);
  voteCommitments.insert(commitment);
  spentNullifiers.insert(disclose(nul));
}

// A verifier can check an opening without changing the public ledger.
export circuit verifyVoteOpening(
  commitment: Bytes<32>,
  vote: Bytes<32>,
  randomness: Bytes<32>
): [] {
  assert(persistentCommit(vote, randomness) == commitment, "Invalid vote opening");
}
